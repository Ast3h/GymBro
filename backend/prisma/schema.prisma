// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model Exercise{
  id Int @id
  nameIt String
  name String
  bodyPart String
  macroPart String
  videoUrl String
  workout_ex workout_exercise[]
  workout_set workout_set[]
  template_ex     workout_template_exercise[]
}

model workout_plan{
  userId Int 
  workoutId Int @id @default(autoincrement())
  name String
  dataCreazione DateTime?
  tipo String
  note String?
  livello Int?
  workout_ex workout_exercise[]
  workout_set workout_set[]
  user User @relation( fields : [userId], references : [id])
  allenamento allenamento[]
}
// UserId deve puntare a UserId della tabella UserId

model workout_exercise{
  workoutId Int 
  exerciseId Int
  nSet Int
  nRep Int?
  workout workout_plan @relation( fields : [workoutId], references : [workoutId])
  exercise Exercise @relation( fields : [exerciseId], references : [id])
  @@id([workoutId, exerciseId])
}

model workout_set{
  workoutId Int
  setId Int
  exerciseId Int
  rep Int
  pesi Int
  workout workout_plan @relation( fields : [workoutId], references : [workoutId])
  exercise Exercise @relation( fields : [exerciseId], references : [id])
  @@id([workoutId, exerciseId, setId])
}


model User{
  id Int @id @default(autoincrement())
  nome String
  cognome String
  email String @unique
  password String
  dataNascita DateTime?
  peso Float?
  altezza Float?
  avatarUrl String?
  genere String?
  obiettivo String
  livello Int
  workout_plan workout_plan[]
  storico_forma storico_forma[]
  allenamento allenamento[]
}


model storico_forma{
  Id Int @id @default(autoincrement())
  peso Float?
  userId Int
  note String?
  data DateTime
  user User @relation( fields : [userId], references : [id])
}

model allenamento {
  id        Int           @id @default(autoincrement())
  userId    Int
  workoutId Int?
  data      DateTime
  durataSec Int?
  volume    Int?
  note      String?
  user      User          @relation(fields: [userId], references: [id])
  workout   workout_plan? @relation(fields: [workoutId], references: [workoutId])
}

///schede di allenamento predefinite

model workout_template {
  templateId  Int      @id @default(autoincrement())
  name        String
  tipo        String
  note        String?
  livello     String?
  template_ex workout_template_exercise[]
}

model workout_template_exercise {
  templateId Int
  exerciseId Int
  nSet       Int
  nRep       Int?
  template   workout_template @relation(fields: [templateId], references: [templateId], onDelete: Cascade)
  exercise   Exercise         @relation(fields: [exerciseId], references: [id])
  @@id([templateId, exerciseId])
}